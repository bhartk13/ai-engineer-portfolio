# LLM (set at least one)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=auto
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_MODEL=gpt-4o-mini

# Failover when rate-limited (429) — tries next model automatically
LLM_FAILOVER=true
# Optional custom chain (provider:model, comma-separated):
# LLM_FAILOVER_MODELS=openai:gpt-4o-mini,google:gemini-2.0-flash,anthropic:claude-3-5-haiku-20241022

# Free-tier fallback (recommended) — get key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash-lite
# Set false to skip Gemini in failover when free quota is exhausted
LLM_FAILOVER_INCLUDE_GOOGLE=true
TAVILY_API_KEY=

# Optional observability
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# Agent configuration
WORKSPACE_ROOT=./workspace
RUNS_ROOT=./runs
DEPLOY_PLATFORM=netlify

# Static deploy (Netlify — default free hosting)
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
